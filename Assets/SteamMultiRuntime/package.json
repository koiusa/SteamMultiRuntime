  "samples": [
    {
      "displayName": "Gameplay Sample",
      "description": "Main gameplay sample with playable stages plus the Unity logo and welcome startup flow.",
      "path": "Samples/Gameplay"
    },
    {
      "displayName": "Steam Multiplayer - Third Person",
      "description": "Primary multiplayer sample with third-person traversal, local play, and Steam lobby flows. Also import Gameplay Sample.",
