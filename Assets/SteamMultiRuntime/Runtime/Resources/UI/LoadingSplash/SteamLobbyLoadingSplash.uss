.splash-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 245);
}

.splash-content {
    align-items: center;
    justify-content: center;
    max-width: 90%;
}

.splash-image {
    width: 560px;
    height: 240px;
    margin-bottom: 20px;
    -unity-background-scale-mode: scale-to-fit;
}

.splash-message {
    -unity-text-align: middle-center;
    white-space: normal;
    font-size: 32px;
    color: rgba(32, 32, 32, 255);
}