/* Shared runtime ScrollView theme. Add this sheet to a UIDocument root to keep
   scrollbars consistent across first-party screens. */
.unity-scroll-view .unity-scroller--vertical {
    width: 10px;
    min-width: 10px;
    max-width: 10px;
    margin-left: 2px;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgb(15, 23, 42);
    border-left-width: 1px;
    border-left-color: rgba(120, 155, 150, 0.22);
}

.unity-scroll-view .unity-scroller--vertical .unity-scroller__low-button,
.unity-scroll-view .unity-scroller--vertical .unity-scroller__high-button {
    display: none;
}

.unity-scroll-view .unity-scroller--vertical .unity-scroller__slider {
    width: 9px;
    min-width: 9px;
    max-width: 9px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.unity-scroll-view .unity-scroller--vertical .unity-base-slider__tracker {
    width: 4px;
    min-width: 4px;
    max-width: 4px;
    align-self: center;
    margin-left: 0;
    margin-right: 0;
    background-color: rgba(30, 41, 59, 0.72);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.unity-scroll-view .unity-scroller--vertical .unity-base-slider__dragger {
    width: 7px;
    min-width: 7px;
    max-width: 7px;
    background-color: rgba(45, 212, 191, 0.65);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.unity-scroll-view .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: rgb(94, 234, 212);
}
