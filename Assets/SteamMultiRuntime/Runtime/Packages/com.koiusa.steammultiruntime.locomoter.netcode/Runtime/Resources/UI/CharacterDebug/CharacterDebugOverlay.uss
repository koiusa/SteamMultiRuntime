#character-debug-window {
    color: rgb(226, 232, 240);
    background-color: rgba(15, 23, 42, 0.96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(94, 234, 212, 0.55);
    border-right-color: rgba(94, 234, 212, 0.55);
    border-top-color: rgba(94, 234, 212, 0.55);
    border-bottom-color: rgba(94, 234, 212, 0.55);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-left: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
}

.character-debug-titlebar {
    height: 38px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(148, 163, 184, 0.3);
    margin-bottom: 7px;
}

.character-debug-title {
    flex-grow: 1;
    color: rgb(94, 234, 212);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.character-debug-close {
    width: 30px;
    height: 26px;
    font-size: 16px;
    color: rgb(248, 113, 113);
    background-color: rgba(127, 29, 29, 0.3);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.character-debug-close:hover {
    background-color: rgba(220, 38, 38, 0.55);
    color: white;
}

.character-debug-selector {
    width: 100%;
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
    overflow: hidden;
}

.character-debug-selector > Button {
    width: 34px;
    min-width: 34px;
    flex-grow: 0;
    flex-shrink: 0;
    height: 28px;
    color: rgb(94, 234, 212);
    background-color: rgba(30, 41, 59, 0.95);
    border-left-color: rgba(94, 234, 212, 0.35);
    border-right-color: rgba(94, 234, 212, 0.35);
    border-top-color: rgba(94, 234, 212, 0.35);
    border-bottom-color: rgba(94, 234, 212, 0.35);
}

.character-debug-target-label {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    height: 28px;
    padding-left: 6px;
    padding-right: 6px;
    -unity-text-align: middle-center;
    color: rgb(241, 245, 249);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
}

.character-debug-refresh,
.character-debug-launcher {
    height: 30px;
    color: rgb(226, 232, 240);
    background-color: rgb(30, 41, 59);
    border-left-color: rgba(94, 234, 212, 0.45);
    border-right-color: rgba(94, 234, 212, 0.45);
    border-top-color: rgba(94, 234, 212, 0.45);
    border-bottom-color: rgba(94, 234, 212, 0.45);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.character-debug-refresh:hover,
.character-debug-launcher:hover,
.character-debug-selector > Button:hover {
    background-color: rgb(15, 118, 110);
    color: white;
}

.character-debug-refresh {
    margin-bottom: 7px;
}

.character-debug-launcher {
    background-color: rgba(15, 23, 42, 0.96);
}

.character-debug-scroll {
    flex-grow: 1;
    min-height: 0;
    background-color: rgba(15, 23, 42, 0.35);
}

.character-debug-scroll .unity-scroller--vertical {
    width: 12px;
    min-width: 12px;
    background-color: rgb(15, 23, 42);
    border-left-width: 1px;
    border-left-color: rgba(94, 234, 212, 0.25);
}

.character-debug-scroll .unity-scroller--vertical .unity-scroller__low-button,
.character-debug-scroll .unity-scroller--vertical .unity-scroller__high-button {
    display: none;
}

.character-debug-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(30, 41, 59, 0.9);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.character-debug-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    width: 8px;
    background-color: rgba(45, 212, 191, 0.65);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.character-debug-section {
    margin-bottom: 5px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 3px;
    padding-bottom: 5px;
    background-color: rgba(30, 41, 59, 0.72);
    border-left-width: 2px;
    border-left-color: rgb(45, 212, 191);
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

.character-debug-section > Toggle {
    color: rgb(153, 246, 228);
    -unity-font-style: bold;
    margin-bottom: 3px;
}

.character-debug-section > Toggle .unity-toggle__checkmark {
    -unity-background-image-tint-color: rgb(94, 234, 212);
}

.character-debug-value {
    color: rgb(203, 213, 225);
    font-size: 12px;
    margin-left: 4px;
    margin-top: 1px;
    margin-bottom: 1px;
    -unity-text-align: middle-left;
    white-space: normal;
}
