#character-debug-window {
    padding-left: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
}

.character-debug-titlebar {
    height: 38px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(148, 163, 184, 0.3);
    margin-bottom: 7px;
}

.character-debug-title {
    flex-grow: 1;
    color: rgb(94, 234, 212);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.character-debug-close {
    width: 30px;
    height: 26px;
    font-size: 16px;
    color: rgb(248, 113, 113);
    background-color: rgba(127, 29, 29, 0.3);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.character-debug-close:hover {
    background-color: rgba(220, 38, 38, 0.55);
    color: white;
}

.character-debug-selector {
    width: 100%;
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
    overflow: hidden;
}

.character-debug-selector > Button {
    width: 34px;
    min-width: 34px;
    flex-grow: 0;
    flex-shrink: 0;
    height: 28px;
    color: rgb(94, 234, 212);
    background-color: rgba(30, 41, 59, 0.95);
    border-left-color: rgba(94, 234, 212, 0.35);
    border-right-color: rgba(94, 234, 212, 0.35);
    border-top-color: rgba(94, 234, 212, 0.35);
    border-bottom-color: rgba(94, 234, 212, 0.35);
}

.character-debug-target-label {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    height: 28px;
    padding-left: 6px;
    padding-right: 6px;
    -unity-text-align: middle-center;
    color: rgb(241, 245, 249);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
}

.character-debug-refresh {
    height: 30px;
    margin-bottom: 7px;
}

.character-debug-launcher {
    height: 30px;
}

.character-debug-content {
    flex-grow: 1;
    min-height: 0;
    background-color: rgba(15, 23, 42, 0.35);
    overflow: hidden;
}

.character-debug-tabs {
    height: 32px;
    flex-direction: row;
    margin-bottom: 6px;
}

.character-debug-tab {
    flex-grow: 1;
    height: 30px;
    margin-right: 4px;
    color: rgb(119, 149, 184);
    background-color: rgba(20, 28, 40, 0.9);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(145, 175, 215, 0.2);
}

.character-debug-tab:hover {
    color: rgb(207, 221, 240);
    background-color: rgba(35, 150, 112, 0.18);
}

.character-debug-tab.active {
    color: rgb(245, 255, 251);
    -unity-font-style: bold;
    background-color: rgba(35, 150, 112, 0.28);
    border-bottom-color: rgb(77, 219, 164);
}

.character-debug-page {
    flex-grow: 1;
    min-height: 0;
}

.character-debug-columns {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
}

.character-debug-column {
    width: 50%;
    min-width: 0;
    padding-right: 3px;
    padding-left: 3px;
}

.character-debug-section {
    margin-bottom: 5px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 3px;
    padding-bottom: 5px;
    border-left-width: 2px;
    border-left-color: rgb(45, 212, 191);
}

.character-debug-section > Toggle {
    color: rgb(153, 246, 228);
    -unity-font-style: bold;
    margin-bottom: 3px;
}

.character-debug-section > Toggle .unity-toggle__checkmark {
    -unity-background-image-tint-color: rgb(94, 234, 212);
}

.character-debug-value {
    color: rgb(203, 213, 225);
    font-size: 12px;
    margin-left: 4px;
    margin-top: 1px;
    margin-bottom: 1px;
    -unity-text-align: middle-left;
    white-space: normal;
}

.character-debug-parameter-title {
    margin-top: 5px;
    margin-bottom: 3px;
    color: rgb(77, 219, 164);
    -unity-font-style: bold;
}

.character-debug-parameter-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.character-debug-parameter-grid > .character-debug-value {
    width: 50%;
    min-width: 0;
    margin-left: 0;
    padding-right: 4px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}
