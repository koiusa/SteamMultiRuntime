.input-guide-screen {
    position: absolute;
    left: 24px;
    bottom: 24px;
    width: 620px;
}

.input-guide-panel {
    padding: 14px;
    background-color: rgba(9, 14, 23, 0.88);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(145, 175, 215, 0.22);
    border-right-color: rgba(145, 175, 215, 0.22);
    border-top-color: rgba(145, 175, 215, 0.22);
    border-bottom-color: rgba(145, 175, 215, 0.22);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.input-guide-header { flex-direction: row; align-items: center; height: 34px; }
.input-guide-accent { width: 3px; height: 28px; margin-right: 9px; background-color: rgb(77, 219, 164); border-top-left-radius: 2px; border-top-right-radius: 2px; border-bottom-left-radius: 2px; border-bottom-right-radius: 2px; }
.input-guide-title { font-size: 13px; -unity-font-style: bold; letter-spacing: 2px; color: rgb(238, 245, 255); }
.input-guide-map { margin-top: -2px; font-size: 9px; color: rgb(116, 141, 173); }
.input-guide-spacer { flex-grow: 1; }
.input-guide-device { padding-left: 7px; padding-right: 7px; padding-top: 4px; padding-bottom: 4px; font-size: 9px; -unity-font-style: bold; color: rgb(149, 174, 205); background-color: rgba(90, 120, 160, 0.16); border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-left-radius: 3px; border-bottom-right-radius: 3px; }
.input-guide-divider { height: 1px; margin-top: 9px; margin-bottom: 7px; background-color: rgba(160, 190, 225, 0.13); }
.input-device-layout {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    padding-top: 5px;
    padding-bottom: 3px;
}

.input-keyboard {
    width: 445px;
    padding: 7px;
    background-color: rgba(1, 5, 10, 0.65);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

.keyboard-row { flex-direction: row; height: 48px; }
.keyboard-row-offset { padding-left: 47px; }
.keyboard-gap { width: 94px; }
.keyboard-gap-one-right { width: 141px; }
.keyboard-gap-small { width: 47px; }

.keycap {
    width: 43px;
    height: 43px;
    margin-right: 4px;
    padding-top: 3px;
    align-items: center;
    background-color: rgb(28, 36, 49);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 3px;
    border-left-color: rgb(68, 82, 102);
    border-right-color: rgb(68, 82, 102);
    border-top-color: rgb(78, 94, 116);
    border-bottom-color: rgb(10, 15, 22);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.keycap-wide { width: 72px; }
.keycap-space { width: 116px; }
.keycap-arrow { background-color: rgb(31, 41, 55); }
.keycap-name { font-size: 12px; -unity-font-style: bold; color: rgb(213, 224, 240); }
.keycap-name-small { font-size: 8px; }

.input-device-action {
    margin-top: 2px;
    max-width: 100%;
    font-size: 7px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(111, 137, 168);
    overflow: hidden;
    white-space: nowrap;
}

.keycap.active {
    translate: 0 2px;
    background-color: rgb(35, 150, 112);
    border-left-color: rgb(83, 245, 181);
    border-right-color: rgb(83, 245, 181);
    border-top-color: rgb(111, 255, 202);
    border-bottom-color: rgb(18, 74, 57);
}

.keycap.active .keycap-name,
.keycap.active .input-device-action { color: rgb(245, 255, 251); }

.input-mouse {
    width: 128px;
    height: 185px;
    margin-left: 14px;
    padding: 5px;
    background-color: rgba(1, 5, 10, 0.65);
    border-top-left-radius: 56px;
    border-top-right-radius: 56px;
    border-bottom-left-radius: 45px;
    border-bottom-right-radius: 45px;
}

.mouse-buttons { flex-direction: row; height: 72px; }
.mouse-button {
    height: 67px;
    align-items: center;
    justify-content: center;
    background-color: rgb(28, 36, 49);
    border-bottom-width: 1px;
    border-bottom-color: rgb(70, 84, 104);
}
.mouse-left { width: 48px; border-top-left-radius: 48px; }
.mouse-middle { width: 22px; margin-left: 2px; margin-right: 2px; }
.mouse-right { width: 48px; border-top-right-radius: 48px; }
.mouse-label { font-size: 9px; -unity-font-style: bold; color: rgb(157, 176, 202); }
.mouse-body { flex-grow: 1; align-items: center; justify-content: center; background-color: rgb(20, 27, 38); border-bottom-left-radius: 40px; border-bottom-right-radius: 40px; transition-property: background-color; transition-duration: 0.12s; transition-timing-function: ease-out; }
.mouse-move-label { font-size: 8px; letter-spacing: 1px; color: rgb(83, 107, 136); }
.mouse-button.active,
.mouse-body.active { background-color: rgb(35, 150, 112); }
.mouse-button.active .mouse-label,
.mouse-body.active .mouse-move-label,
.mouse-button.active .input-device-action,
.mouse-body.active .input-device-action { color: rgb(245, 255, 251); }
.input-guide-footer { margin-top: 9px; font-size: 8px; letter-spacing: 1px; -unity-text-align: middle-right; color: rgb(76, 109, 143); }

.input-gamepad {
    display: none;
    width: 573px;
    height: 185px;
    padding: 8px;
    background-color: rgba(1, 5, 10, 0.65);
    border-top-left-radius: 55px;
    border-top-right-radius: 55px;
    border-bottom-left-radius: 28px;
    border-bottom-right-radius: 28px;
}
.gamepad-shoulders, .gamepad-body, .gamepad-dpad-row, .gamepad-face-row { flex-direction: row; }
.gamepad-shoulders { height: 38px; align-items: center; }
.gamepad-flex-spacer, .gamepad-center { flex-grow: 1; }
.gamepad-body { height: 125px; align-items: center; }
.gamepad-side { width: 155px; height: 120px; flex-direction: row; align-items: center; }
.gamepad-side-right { justify-content: flex-end; }
.gamepad-center { align-items: center; justify-content: center; }
.gamepad-brand { font-size: 8px; letter-spacing: 2px; color: rgb(76, 109, 143); }
.gamepad-button, .gamepad-stick, .gamepad-stick-press {
    align-items: center;
    justify-content: center;
    background-color: rgb(28, 36, 49);
    border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 2px;
    border-left-color: rgb(68, 82, 102); border-right-color: rgb(68, 82, 102);
    border-top-color: rgb(78, 94, 116); border-bottom-color: rgb(10, 15, 22);
}
.gamepad-shoulder { width: 62px; height: 30px; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; }
.gamepad-trigger { width: 48px; height: 25px; margin-left: 5px; margin-right: 5px; border-top-left-radius: 7px; border-top-right-radius: 7px; border-bottom-left-radius: 7px; border-bottom-right-radius: 7px; }
.gamepad-stick { width: 54px; height: 54px; border-top-left-radius: 27px; border-top-right-radius: 27px; border-bottom-left-radius: 27px; border-bottom-right-radius: 27px; }
.gamepad-stick-press { width: 28px; height: 28px; margin-left: -17px; margin-top: 42px; border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; }
.gamepad-dpad { width: 84px; margin-left: 9px; align-items: center; }
.gamepad-dpad-up, .gamepad-dpad-key { width: 27px; height: 27px; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; }
.gamepad-dpad-spacer { width: 27px; height: 27px; }
.gamepad-face-row { width: 92px; height: 92px; flex-wrap: wrap; }
.gamepad-face { width: 38px; height: 38px; margin: 4px; border-top-left-radius: 19px; border-top-right-radius: 19px; border-bottom-left-radius: 19px; border-bottom-right-radius: 19px; }
.gamepad-west { margin-top: 27px; }
.gamepad-north { margin-top: 0; }
.gamepad-east { margin-top: -19px; margin-left: 50px; }
.gamepad-south { margin-top: -19px; margin-left: 4px; }
.gamepad-label { font-size: 9px; -unity-font-style: bold; color: rgb(213, 224, 240); }
.gamepad-label-small { font-size: 7px; -unity-font-style: bold; color: rgb(180, 198, 220); }
.gamepad-button.active, .gamepad-stick.active, .gamepad-stick-press.active {
    background-color: rgb(35, 150, 112);
    border-left-color: rgb(83, 245, 181); border-right-color: rgb(83, 245, 181);
    border-top-color: rgb(111, 255, 202); border-bottom-color: rgb(18, 74, 57);
}
.gamepad-button.active .gamepad-label, .gamepad-button.active .gamepad-label-small,
.gamepad-stick.active .gamepad-label, .gamepad-stick-press.active .gamepad-label-small,
.gamepad-button.active .input-device-action, .gamepad-stick.active .input-device-action,
.gamepad-stick-press.active .input-device-action { color: rgb(245, 255, 251); }
