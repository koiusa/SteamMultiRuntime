<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="InputGuideOverlay.uss" />
    <ui:VisualElement name="input-guide-overlay" class="input-guide-screen">
        <ui:VisualElement class="input-guide-panel">
            <ui:VisualElement class="input-guide-header">
                <ui:VisualElement class="input-guide-accent" />
                <ui:VisualElement>
                    <ui:Label text="CONTROLS" class="input-guide-title" />
                    <ui:Label name="map-label" text="GAMEPLAY" class="input-guide-map" />
                </ui:VisualElement>
                <ui:VisualElement class="input-guide-spacer" />
                <ui:Label name="device-label" text="KEYBOARD" class="input-guide-device" />
            </ui:VisualElement>
            <ui:VisualElement class="input-guide-divider" />
            <ui:VisualElement name="device-layout" class="input-device-layout">
                <ui:VisualElement name="keyboard-layout-host" />
                <ui:VisualElement name="mouse-layout-host" />
                <ui:VisualElement name="gamepad-layout-host" />
            </ui:VisualElement>
            <ui:Label text="LIVE INPUT MONITOR" class="input-guide-footer" />
        </ui:VisualElement>
        <ui:VisualElement class="input-operation-panel">
            <ui:VisualElement class="input-operation-header">
                <ui:Label text="OPERATIONS" class="input-guide-title" />
                <ui:Label text="F1 / TOUCH PAD" class="input-operation-toggle-hint" />
            </ui:VisualElement>
            <ui:VisualElement class="input-guide-divider" />
            <ui:VisualElement class="input-operation-sections">
                <ui:VisualElement name="keyboard-operation-list" class="input-operation-list" />
                <ui:VisualElement name="gamepad-operation-list" class="input-operation-list" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
