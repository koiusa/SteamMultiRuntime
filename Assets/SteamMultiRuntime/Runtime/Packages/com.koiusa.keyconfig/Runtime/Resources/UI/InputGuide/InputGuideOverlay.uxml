<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="InputGuideOverlay.uss" />
    <ui:VisualElement name="input-guide-overlay" class="input-guide-screen">
        <ui:VisualElement class="input-guide-panel">
            <ui:VisualElement class="input-guide-header">
                <ui:VisualElement class="input-guide-accent" />
                <ui:VisualElement>
                    <ui:Label text="CONTROLS" class="input-guide-title" />
                    <ui:Label name="map-label" text="GAMEPLAY" class="input-guide-map" />
                </ui:VisualElement>
                <ui:VisualElement class="input-guide-spacer" />
                <ui:Label name="device-label" text="KEYBOARD" class="input-guide-device" />
            </ui:VisualElement>
            <ui:VisualElement class="input-guide-divider" />
            <ui:VisualElement name="device-layout" class="input-device-layout">
                <ui:VisualElement name="keyboard-layout" class="input-keyboard">
                    <ui:VisualElement class="keyboard-row">
                        <ui:VisualElement name="control-1" class="keycap"><ui:Label text="1" class="keycap-name" /></ui:VisualElement>
                        <ui:VisualElement name="control-2" class="keycap"><ui:Label text="2" class="keycap-name" /></ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="keyboard-row keyboard-row-offset">
                        <ui:VisualElement name="control-w" class="keycap"><ui:Label text="W" class="keycap-name" /></ui:VisualElement>
                        <ui:VisualElement name="control-e" class="keycap"><ui:Label text="E" class="keycap-name" /></ui:VisualElement>
                        <ui:VisualElement class="keyboard-gap keyboard-gap-one-right" />
                        <ui:VisualElement name="control-uparrow" class="keycap keycap-arrow"><ui:Label text="▲" class="keycap-name" /></ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="keyboard-row">
                        <ui:VisualElement name="control-a" class="keycap"><ui:Label text="A" class="keycap-name" /></ui:VisualElement>
                        <ui:VisualElement name="control-s" class="keycap"><ui:Label text="S" class="keycap-name" /></ui:VisualElement>
                        <ui:VisualElement name="control-d" class="keycap"><ui:Label text="D" class="keycap-name" /></ui:VisualElement>
                        <ui:VisualElement name="control-g" class="keycap"><ui:Label text="G" class="keycap-name" /></ui:VisualElement>
                        <ui:VisualElement name="control-h" class="keycap"><ui:Label text="H" class="keycap-name" /></ui:VisualElement>
                        <ui:VisualElement name="control-leftarrow" class="keycap keycap-arrow"><ui:Label text="◀" class="keycap-name" /></ui:VisualElement>
                        <ui:VisualElement name="control-downarrow" class="keycap keycap-arrow"><ui:Label text="▼" class="keycap-name" /></ui:VisualElement>
                        <ui:VisualElement name="control-rightarrow" class="keycap keycap-arrow"><ui:Label text="▶" class="keycap-name" /></ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="keyboard-row">
                        <ui:VisualElement name="control-leftalt" class="keycap keycap-wide"><ui:Label text="ALT" class="keycap-name keycap-name-small" /></ui:VisualElement>
                        <ui:VisualElement name="control-leftshift" class="keycap keycap-wide"><ui:Label text="SHIFT" class="keycap-name keycap-name-small" /></ui:VisualElement>
                        <ui:VisualElement name="control-c" class="keycap"><ui:Label text="C" class="keycap-name" /></ui:VisualElement>
                        <ui:VisualElement name="control-space" class="keycap keycap-space"><ui:Label text="SPACE" class="keycap-name keycap-name-small" /></ui:VisualElement>
                        <ui:VisualElement name="control-enter" class="keycap keycap-wide"><ui:Label text="ENTER" class="keycap-name keycap-name-small" /></ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="input-mouse">
                    <ui:VisualElement class="mouse-buttons">
                        <ui:VisualElement name="control-leftbutton" class="mouse-button mouse-left"><ui:Label text="L" class="mouse-label" /></ui:VisualElement>
                        <ui:VisualElement name="control-middlebutton" class="mouse-button mouse-middle"><ui:Label text="●" class="mouse-label" /></ui:VisualElement>
                        <ui:VisualElement name="control-rightbutton" class="mouse-button mouse-right"><ui:Label text="R" class="mouse-label" /></ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="control-delta" class="mouse-body"><ui:Label text="MOVE" class="mouse-move-label" /></ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="gamepad-layout" class="input-gamepad">
                    <ui:VisualElement class="gamepad-shoulders">
                        <ui:VisualElement name="control-leftshoulder" class="gamepad-button gamepad-shoulder"><ui:Label text="LB" class="gamepad-label" /></ui:VisualElement>
                        <ui:VisualElement name="control-lefttrigger" class="gamepad-button gamepad-trigger"><ui:Label text="LT" class="gamepad-label" /></ui:VisualElement>
                        <ui:VisualElement class="gamepad-flex-spacer" />
                        <ui:VisualElement name="control-righttrigger" class="gamepad-button gamepad-trigger"><ui:Label text="RT" class="gamepad-label" /></ui:VisualElement>
                        <ui:VisualElement name="control-rightshoulder" class="gamepad-button gamepad-shoulder"><ui:Label text="RB" class="gamepad-label" /></ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="gamepad-body">
                        <ui:VisualElement class="gamepad-side">
                            <ui:VisualElement name="control-leftstick" class="gamepad-stick"><ui:Label text="LS" class="gamepad-label" /></ui:VisualElement>
                            <ui:VisualElement name="control-leftstickpress" class="gamepad-stick-press"><ui:Label text="L3" class="gamepad-label-small" /></ui:VisualElement>
                            <ui:VisualElement class="gamepad-dpad">
                                <ui:VisualElement name="control-up" class="gamepad-button gamepad-dpad-up"><ui:Label text="▲" class="gamepad-label-small" /></ui:VisualElement>
                                <ui:VisualElement class="gamepad-dpad-row">
                                    <ui:VisualElement name="control-left" class="gamepad-button gamepad-dpad-key"><ui:Label text="◀" class="gamepad-label-small" /></ui:VisualElement>
                                    <ui:VisualElement class="gamepad-dpad-spacer" />
                                    <ui:VisualElement name="control-right" class="gamepad-button gamepad-dpad-key"><ui:Label text="▶" class="gamepad-label-small" /></ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement name="control-down" class="gamepad-button gamepad-dpad-key"><ui:Label text="▼" class="gamepad-label-small" /></ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="gamepad-center">
                            <ui:VisualElement class="gamepad-center-row">
                                <ui:VisualElement name="control-select" class="gamepad-button gamepad-menu-button"><ui:Label text="SHARE" class="gamepad-label-tiny" /></ui:VisualElement>
                                <ui:VisualElement name="control-start" class="gamepad-button gamepad-menu-button"><ui:Label text="OPTION" class="gamepad-label-tiny" /></ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="control-touchpadbutton" class="gamepad-button gamepad-touchpad"><ui:Label text="TOUCH PAD" class="gamepad-label-tiny" /></ui:VisualElement>
                            <ui:VisualElement name="control-systembutton" class="gamepad-button gamepad-system-button"><ui:Label text="PS" class="gamepad-label-small" /></ui:VisualElement>
                            <ui:Label text="GAMEPAD" class="gamepad-brand" />
                        </ui:VisualElement>
                        <ui:VisualElement class="gamepad-side gamepad-side-right">
                            <ui:VisualElement class="gamepad-face-row">
                                <ui:VisualElement name="control-buttonwest" class="gamepad-button gamepad-face gamepad-west"><ui:Label text="X" class="gamepad-label" /></ui:VisualElement>
                                <ui:VisualElement name="control-buttonnorth" class="gamepad-button gamepad-face gamepad-north"><ui:Label text="Y" class="gamepad-label" /></ui:VisualElement>
                                <ui:VisualElement name="control-buttoneast" class="gamepad-button gamepad-face gamepad-east"><ui:Label text="B" class="gamepad-label" /></ui:VisualElement>
                                <ui:VisualElement name="control-buttonsouth" class="gamepad-button gamepad-face gamepad-south"><ui:Label text="A" class="gamepad-label" /></ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="control-rightstick" class="gamepad-stick"><ui:Label text="RS" class="gamepad-label" /></ui:VisualElement>
                            <ui:VisualElement name="control-rightstickpress" class="gamepad-stick-press"><ui:Label text="R3" class="gamepad-label-small" /></ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label text="LIVE INPUT MONITOR" class="input-guide-footer" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
