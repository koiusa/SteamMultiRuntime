	.keyconfig-root {
	width: 100%;
	height: 100%;
	align-items: center;
	justify-content: center;
	padding-left: 24px;
	padding-right: 24px;
	padding-top: 24px;
	padding-bottom: 24px;
	background-color: rgba(0, 0, 0, 0.35);
}

.keyconfig-panel {
	min-width: 560px;
	width: 72%;
	max-width: 960px;
	max-height: 680px;
	padding-left: 24px;
	padding-right: 24px;
	padding-top: 20px;
	padding-bottom: 20px;
	background-color: rgba(18, 22, 32, 0.96);
	border-left-width: 1px;
	border-right-width: 1px;
	border-top-width: 1px;
	border-bottom-width: 1px;
	border-left-color: rgba(255, 255, 255, 0.10);
	border-right-color: rgba(255, 255, 255, 0.10);
	border-top-color: rgba(255, 255, 255, 0.10);
	border-bottom-color: rgba(255, 255, 255, 0.10);
	border-top-left-radius: 6px;
	border-top-right-radius: 6px;
	border-bottom-left-radius: 6px;
	border-bottom-right-radius: 6px;
}

.keyconfig-title {
	font-size: 26px;
	-unity-font-style: bold;
	color: rgb(245, 247, 250);
	margin-bottom: 10px;
}

.keyconfig-status {
	font-size: 12px;
	color: rgb(160, 175, 200);
	margin-bottom: 8px;
	min-height: 16px;
}

/* ---------- タブ / ドロップダウン ---------- */

.keyconfig-binding-group-dropdown {
	margin-bottom: 8px;
}

.keyconfig-map-tabs {
	flex-direction: row;
	flex-wrap: nowrap;
	margin-bottom: 0;
}

.keyconfig-map-tab-button {
	height: 32px;
	margin-right: 4px;
	margin-bottom: 0;
	padding-left: 14px;
	padding-right: 14px;
	font-size: 13px;
	background-color: rgba(255, 255, 255, 0.05);
	border-bottom-width: 0;
	border-top-left-radius: 4px;
	border-top-right-radius: 4px;
	border-bottom-left-radius: 0;
	border-bottom-right-radius: 0;
	color: rgb(180, 190, 210);
}

.keyconfig-map-tab-button.active {
	background-color: rgba(80, 130, 220, 0.40);
	color: rgb(240, 245, 255);
	-unity-font-style: bold;
}

/* ---------- テーブル ---------- */

.keyconfig-table-header {
	flex-direction: row;
	align-items: center;
	padding-left: 8px;
	padding-right: 8px;
	padding-top: 6px;
	padding-bottom: 6px;
	background-color: rgba(60, 80, 120, 0.45);
	border-bottom-width: 1px;
	border-bottom-color: rgba(255, 255, 255, 0.12);
}

.keyconfig-th {
	font-size: 12px;
	-unity-font-style: bold;
	color: rgb(160, 180, 220);
	-unity-text-align: middle-left;
}

.keyconfig-th-action {
	width: 30%;
	min-width: 120px;
}

.keyconfig-th-binding {
	flex-grow: 1;
}

.keyconfig-th-buttons {
	width: 196px;
	flex-shrink: 0;
}

.keyconfig-list {
	flex-grow: 1;
	min-height: 220px;
	max-height: 460px;
	margin-bottom: 12px;
}

/* ---------- グループヘッダー ---------- */

.keyconfig-scheme-group-header {
	margin-top: 10px;
	margin-bottom: 0;
	padding-left: 8px;
	padding-top: 5px;
	padding-bottom: 5px;
	font-size: 11px;
	-unity-font-style: bold;
	color: rgb(255, 200, 120);
	background-color: rgba(255, 180, 60, 0.10);
	border-left-width: 3px;
	border-left-color: rgb(255, 180, 60);
}

.keyconfig-profile-group-header {
	margin-top: 0;
	margin-bottom: 0;
	padding-left: 16px;
	padding-top: 4px;
	padding-bottom: 4px;
	font-size: 11px;
	-unity-font-style: bold;
	color: rgb(160, 200, 255);
	background-color: rgba(80, 130, 220, 0.10);
}

/* ---------- テーブル行 ---------- */

.keyconfig-row {
	flex-direction: row;
	align-items: center;
	padding-left: 8px;
	padding-right: 8px;
	padding-top: 5px;
	padding-bottom: 5px;
	border-bottom-width: 1px;
	border-bottom-color: rgba(255, 255, 255, 0.05);
}

.keyconfig-row.even {
	background-color: rgba(255, 255, 255, 0.02);
}

.keyconfig-row.odd {
	background-color: rgba(0, 0, 0, 0);
}

.keyconfig-row:hover {
	background-color: rgba(80, 130, 220, 0.15);
}

.keyconfig-cell-action {
	width: 30%;
	min-width: 120px;
	color: rgb(220, 228, 245);
	font-size: 13px;
	overflow: hidden;
	padding-left: 12px;
}

.keyconfig-cell-action.composite-child {
	color: rgb(150, 160, 180);
	font-size: 12px;
	padding-left: 24px;
}

.keyconfig-cell-binding {
	flex-grow: 1;
	flex-direction: row;
	align-items: center;
}

.keyconfig-binding-icon {
	width: 28px;
	height: 28px;
	margin-right: 6px;
	flex-shrink: 0;
}

.keyconfig-binding-label {
	color: rgb(200, 215, 240);
	font-size: 13px;
	flex-grow: 1;
}

.keyconfig-cell-buttons {
	flex-direction: row;
	align-items: center;
	width: 196px;
	flex-shrink: 0;
	justify-content: flex-end;
}

.keyconfig-rebind-button {
	width: 90px;
	height: 26px;
	margin-right: 6px;
	font-size: 12px;
}

.keyconfig-reset-button {
	width: 80px;
	height: 26px;
	font-size: 12px;
}

/* ---------- ボトムボタン ---------- */

.keyconfig-buttons-row {
	flex-direction: row;
	justify-content: flex-end;
	margin-top: 4px;
}

.keyconfig-button {
	width: 100px;
	height: 36px;
	margin-left: 8px;
}
