	.keyconfig-root {
	width: 100%;
	height: 100%;
	align-items: center;
	justify-content: center;
	padding-left: 24px;
	padding-right: 24px;
	padding-top: 24px;
	padding-bottom: 24px;
	background-color: rgba(0, 0, 0, 0.35);
}

.keyconfig-panel {
	min-width: 560px;
	width: 72%;
	max-width: 960px;
	max-height: 680px;
	padding-left: 24px;
	padding-right: 24px;
	padding-top: 20px;
	padding-bottom: 20px;
}

.keyconfig-title {
	font-size: 26px;
	margin-bottom: 10px;
}

.keyconfig-status {
	font-size: 12px;
	color: rgb(160, 175, 200);
	margin-bottom: 8px;
	min-height: 16px;
}

.keyconfig-input-help {
	font-size: 12px;
	color: rgb(190, 205, 230);
	margin-bottom: 5px;
}

.keyconfig-input-monitor {
	flex-direction: row;
	align-items: center;
	height: 34px;
	margin-top: 3px;
	margin-bottom: 8px;
	padding-left: 10px;
	padding-right: 10px;
}

.keyconfig-input-monitor-dot {
	margin-right: 7px;
	font-size: 11px;
	color: rgb(85, 105, 130);
}

.keyconfig-input-monitor-dot.active {
	color: rgb(70, 235, 165);
}

.keyconfig-input-monitor-title {
	font-size: 11px;
	-unity-font-style: bold;
	letter-spacing: 1px;
	color: rgb(175, 195, 225);
}

.keyconfig-input-monitor-spacer {
	flex-grow: 1;
}

.keyconfig-input-monitor-status {
	font-size: 10px;
	-unity-font-style: bold;
	color: rgb(95, 225, 170);
}

/* ---------- タブ / ドロップダウン ---------- */

.keyconfig-binding-group-dropdown {
	margin-bottom: 8px;
}

.keyconfig-map-tabs {
	flex-direction: row;
	flex-wrap: nowrap;
	margin-bottom: 0;
}

.keyconfig-map-tab-button {
	height: 32px;
	margin-right: 4px;
	margin-bottom: 0;
	padding-left: 14px;
	padding-right: 14px;
	font-size: 13px;
	border-bottom-left-radius: 0;
	border-bottom-right-radius: 0;
}

/* ---------- テーブル ---------- */

.keyconfig-table-header {
	flex-direction: row;
	align-items: center;
	padding-left: 8px;
	padding-right: 8px;
	padding-top: 6px;
	padding-bottom: 6px;
	border-bottom-width: 1px;
}

.keyconfig-th {
	font-size: 12px;
	-unity-font-style: bold;
	color: rgb(160, 180, 220);
	-unity-text-align: middle-left;
}

.keyconfig-th-action {
	width: 30%;
	min-width: 120px;
}

.keyconfig-th-binding {
	flex-grow: 1;
}

.keyconfig-th-buttons {
	width: 196px;
	flex-shrink: 0;
}

.keyconfig-list {
	flex-grow: 1;
	min-height: 220px;
	max-height: 460px;
	margin-bottom: 12px;
}

/* ---------- グループヘッダー ---------- */

.keyconfig-scheme-group-header {
	margin-top: 10px;
	margin-bottom: 0;
	padding-left: 8px;
	padding-top: 5px;
	padding-bottom: 5px;
	font-size: 11px;
	-unity-font-style: bold;
	color: rgb(255, 200, 120);
	background-color: rgba(255, 180, 60, 0.10);
	border-left-width: 3px;
	border-left-color: rgb(255, 180, 60);
}

.keyconfig-profile-group-header {
	margin-top: 0;
	margin-bottom: 0;
	padding-left: 16px;
	padding-top: 4px;
	padding-bottom: 4px;
	font-size: 11px;
	-unity-font-style: bold;
	color: rgb(160, 200, 255);
	background-color: rgba(80, 130, 220, 0.10);
}

/* ---------- テーブル行 ---------- */

.keyconfig-row {
	flex-direction: row;
	align-items: center;
	padding-left: 8px;
	padding-right: 8px;
	padding-top: 5px;
	padding-bottom: 5px;
	border-bottom-width: 1px;
}

.keyconfig-row.even {
	background-color: rgba(255, 255, 255, 0.02);
}

.keyconfig-row.odd {
	background-color: rgba(0, 0, 0, 0);
}

.keyconfig-row.input-active {
	border-left-width: 3px;
}

.keyconfig-cell-action {
	width: 30%;
	min-width: 120px;
	color: rgb(220, 228, 245);
	font-size: 13px;
	overflow: hidden;
	padding-left: 12px;
}

.keyconfig-cell-action.composite-child {
	color: rgb(150, 160, 180);
	font-size: 12px;
	padding-left: 24px;
}

.keyconfig-cell-binding {
	flex-grow: 1;
	flex-direction: row;
	align-items: center;
}

.keyconfig-binding-icon {
	width: 28px;
	height: 28px;
	margin-right: 6px;
	flex-shrink: 0;
}

.keyconfig-binding-label {
	color: rgb(200, 215, 240);
	font-size: 13px;
	flex-grow: 1;
}

.keyconfig-input-state {
	margin-left: 8px;
	font-size: 11px;
	-unity-font-style: bold;
	color: rgb(85, 245, 175);
	white-space: nowrap;
}

.keyconfig-cell-buttons {
	flex-direction: row;
	align-items: center;
	width: 196px;
	flex-shrink: 0;
	justify-content: flex-end;
}

.keyconfig-row-button {
	height: 28px;
	padding-left: 10px;
	padding-right: 10px;
	border-left-width: 1px;
	border-right-width: 1px;
	border-top-width: 1px;
	border-bottom-width: 1px;
	border-top-left-radius: 4px;
	border-top-right-radius: 4px;
	border-bottom-left-radius: 4px;
	border-bottom-right-radius: 4px;
	-unity-font-style: bold;
	-unity-text-align: middle-center;
}

.keyconfig-rebind-button {
	width: 90px;
	margin-right: 6px;
	font-size: 12px;
	color: rgb(225, 240, 255);
	background-color: rgb(42, 92, 168);
	border-left-color: rgb(92, 155, 245);
	border-right-color: rgb(92, 155, 245);
	border-top-color: rgb(92, 155, 245);
	border-bottom-color: rgb(92, 155, 245);
}

.keyconfig-rebind-button:hover {
	background-color: rgb(56, 118, 205);
	border-left-color: rgb(135, 188, 255);
	border-right-color: rgb(135, 188, 255);
	border-top-color: rgb(135, 188, 255);
	border-bottom-color: rgb(135, 188, 255);
}

.keyconfig-rebind-button:active {
	background-color: rgb(30, 70, 132);
	color: rgb(195, 220, 250);
}

.keyconfig-reset-button {
	width: 80px;
	font-size: 12px;
	color: rgb(235, 220, 225);
	background-color: rgb(92, 52, 62);
	border-left-color: rgb(175, 92, 108);
	border-right-color: rgb(175, 92, 108);
	border-top-color: rgb(175, 92, 108);
	border-bottom-color: rgb(175, 92, 108);
}

.keyconfig-reset-button:hover {
	background-color: rgb(125, 62, 76);
	border-left-color: rgb(220, 115, 135);
	border-right-color: rgb(220, 115, 135);
	border-top-color: rgb(220, 115, 135);
	border-bottom-color: rgb(220, 115, 135);
}

.keyconfig-reset-button:active {
	background-color: rgb(68, 38, 47);
	color: rgb(205, 190, 195);
}

.keyconfig-row-button:disabled {
	color: rgb(115, 125, 145);
	background-color: rgba(45, 52, 65, 0.65);
	border-left-color: rgb(70, 78, 94);
	border-right-color: rgb(70, 78, 94);
	border-top-color: rgb(70, 78, 94);
	border-bottom-color: rgb(70, 78, 94);
}

/* ---------- ボトムボタン ---------- */

.keyconfig-buttons-row {
	flex-direction: row;
	justify-content: flex-end;
	margin-top: 4px;
}

.keyconfig-button {
	width: 100px;
	height: 36px;
	margin-left: 8px;
}
