File: Assets\SteamMultiRuntime\Runtime\Resources\UI\SteamLobby\SteamLobbyView.uss
````````
.root {
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 20px;
    padding-bottom: 20px;
    background-color: rgba(0, 0, 0, 0);
}

.panel {
    max-width: 760px;
    flex-direction: column;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 14px;
    padding-bottom: 14px;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-color: rgba(50, 235, 255, 160);
    border-bottom-color: rgba(50, 235, 255, 160);
    border-left-color: rgba(50, 235, 255, 160);
    border-right-color: rgba(50, 235, 255, 160);
}

.title {
    -unity-font-style: bold;
    font-size: 22px;
    color: rgba(153, 248, 255, 255);
    margin-bottom: 12px;
}

.status {
    margin-bottom: 4px;
    color: rgba(208, 236, 255, 255);
}

.info {
    margin-bottom: 10px;
    color: rgba(127, 224, 255, 255);
}

.row {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 10px;
}

.field {
    margin-bottom: 6px;
    color: rgba(226, 245, 255, 255);
}

.field > .unity-base-field__label {
    color: rgba(148, 228, 255, 255);
}

.field > .unity-base-text-field__input,
.field > .unity-text-field__input {
    color: rgba(220, 244, 255, 255);
    background-color: rgba(9, 24, 40, 230);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(83, 208, 235, 180);
    border-bottom-color: rgba(83, 208, 235, 180);
    border-left-color: rgba(83, 208, 235, 180);
    border-right-color: rgba(83, 208, 235, 180);
}

.field > .unity-base-text-field__input:focus,
.field > .unity-text-field__input:focus {
    background-color: rgba(15, 40, 66, 245);
    border-top-color: rgba(117, 236, 255, 220);
    border-bottom-color: rgba(117, 236, 255, 220);
    border-left-color: rgba(117, 236, 255, 220);
    border-right-color: rgba(117, 236, 255, 220);
}

.grow {
    flex-grow: 1;
    margin-right: 6px;
}

.button {
    margin-right: 6px;
    color: rgba(166, 241, 255, 255);
    background-color: rgba(20, 42, 72, 255);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(88, 237, 255, 200);
    border-bottom-color: rgba(88, 237, 255, 200);
    border-left-color: rgba(88, 237, 255, 200);
    border-right-color: rgba(88, 237, 255, 200);
}

.button:hover {
    background-color: rgba(28, 64, 96, 255);
}

.button:active {
    background-color: rgba(15, 96, 122, 255);
}

.narrow {
    width: 120px;
}

.section-title {
    -unity-font-style: bold;
    margin-bottom: 6px;
    color: rgba(124, 239, 255, 255);
}

.lobby-list {
    height: 320px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(51, 168, 204, 220);
    border-bottom-color: rgba(51, 168, 204, 220);
    border-left-color: rgba(51, 168, 204, 220);
    border-right-color: rgba(51, 168, 204, 220);
    background-color: rgba(7, 14, 24, 230);
}

.lobby-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin-bottom: 5px;
    background-color: rgba(14, 28, 46, 220);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(52, 147, 190, 180);
    border-bottom-color: rgba(52, 147, 190, 180);
    border-left-color: rgba(52, 147, 190, 180);
    border-right-color: rgba(52, 147, 190, 180);
}

.lobby-row-label {
    flex-grow: 1;
    color: rgba(218, 238, 255, 255);
}

.join-button {
    margin-left: 6px;
}

.muted {
    color: rgba(136, 174, 199, 255);
}
