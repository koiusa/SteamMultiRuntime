<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="Styles/SteamLobbyCommon.uss" />
    <ui:Style src="Styles/SteamLobbyBase.uss" />
    <ui:VisualElement class="root">
        <ui:VisualElement class="panel main-panel">
            <ui:Label text="Steam Lobby" class="title" />

            <ui:VisualElement class="lobby-content-row">
                <ui:VisualElement class="lobby-controls-column">
                    <ui:VisualElement name="status-panel-host" />
                    <ui:VisualElement name="online-members-panel-host" />
                    <ui:VisualElement name="create-focus-group" class="lobby-focus-group lobby-create-focus-group">
                        <ui:Label text="シーン選択・ロビー作成  [LB: 一覧 / RB: 検索]" class="focus-group-title" />
                        <ui:VisualElement name="create-panel-host" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="lobby-list-column">
                    <ui:VisualElement name="search-focus-group" class="lobby-focus-group lobby-search-focus-group">
                        <ui:Label text="ロビー検索・直接参加  [LB: 作成 / RB: 一覧]" class="focus-group-title" />
                        <ui:VisualElement name="join-panel-host" />
                        <ui:VisualElement name="search-panel-host" />
                        <ui:VisualElement name="actions-panel-host" />
                    </ui:VisualElement>
                    <ui:VisualElement name="list-focus-group" class="lobby-focus-group lobby-list-focus-group">
                        <ui:Label text="ロビーを選択して決定  [↑↓ 選択 / 決定で参加 / LB: 検索 / RB: 作成]" class="focus-group-title" />
                        <ui:VisualElement name="list-panel-host" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
