.target-indicators {
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
}

.target-marker {
	position: absolute;
}

.target-marker > .marker-circle {
	width: 100%;
	height: 100%;
	border-top-width: 2px;
	border-right-width: 2px;
	border-bottom-width: 2px;
	border-left-width: 2px;
	border-top-left-radius: 50%;
	border-top-right-radius: 50%;
	border-bottom-left-radius: 50%;
	border-bottom-right-radius: 50%;
}

.target-marker > .marker-label {
	position: absolute;
	left: 0;
	right: 0;
	bottom: -25px;
	font-size: 12px;
	-unity-text-align: middle-center;
	white-space: nowrap;
	color: rgba(255, 255, 255, 0.9);
}

.target-marker.unfocused > .marker-circle {
	border-top-color: rgba(128, 179, 255, 0.8);
	border-right-color: rgba(128, 179, 255, 0.8);
	border-bottom-color: rgba(128, 179, 255, 0.8);
	border-left-color: rgba(128, 179, 255, 0.8);
	background-color: rgba(128, 179, 255, 0.05);
}

.target-marker.locked > .marker-circle {
	border-top-color: rgba(255, 89, 89, 1.0);
	border-right-color: rgba(255, 89, 89, 1.0);
	border-bottom-color: rgba(255, 89, 89, 1.0);
	border-left-color: rgba(255, 89, 89, 1.0);
	background-color: rgba(255, 89, 89, 0.10);
}

.target-marker.focused > .marker-circle {
	border-top-color: rgba(255, 204, 51, 1.0);
	border-right-color: rgba(255, 204, 51, 1.0);
	border-bottom-color: rgba(255, 204, 51, 1.0);
	border-left-color: rgba(255, 204, 51, 1.0);
	background-color: rgba(255, 204, 51, 0.15);
}

.target-marker.locked > .marker-label,
.target-marker.focused > .marker-label {
	color: rgba(255, 255, 255, 1.0);
}
