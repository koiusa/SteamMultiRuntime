.section-title {
    -unity-font-style: bold;
    margin-bottom: 6px;
    color: rgba(196, 245, 255, 255);
}

.muted {
    color: rgba(162, 208, 230, 255);
}

.create-panel,
.join-panel,
.search-panel,
.actions-panel,
.online-members-panel {
    background-color: rgba(7, 20, 34, 130);
}

.field {
    --unity-cursor-color: rgba(150, 245, 255, 255);
    --unity-selection-color: rgba(65, 165, 210, 140);
}

/* Shared runtime DropdownField popup. The popup is attached directly to the
   panel root, so these classes intentionally aren't scoped below .field. */
.unity-base-dropdown {
    min-width: 280px;
    max-height: 350px;
    padding-left: 2px;
    padding-right: 2px;
    padding-top: 2px;
    padding-bottom: 2px;
    background-color: rgba(7, 18, 30, 255);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.unity-base-dropdown > .unity-scroll-view__content-viewport,
.unity-base-dropdown .unity-scroll-view__content-viewport {
    background-color: rgba(7, 18, 30, 255);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.unity-base-dropdown .unity-scroll-view__content-container {
    padding-left: 2px;
    padding-right: 2px;
    padding-top: 2px;
    padding-bottom: 2px;
    background-color: rgba(7, 18, 30, 255);
}

.unity-base-dropdown .unity-scroll-view__vertical-scroller {
    width: 8px;
    margin-left: 3px;
    background-color: rgba(18, 31, 43, 255);
}

.unity-base-dropdown .unity-scroller__slider {
    min-height: 24px;
    background-color: rgba(112, 137, 145, 210);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.unity-base-dropdown .unity-scroller__slider:hover {
    background-color: rgba(108, 230, 255, 230);
}

.unity-base-dropdown__container-outer {
    min-width: 280px;
    max-height: 360px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
    background-color: rgba(5, 17, 30, 252);
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-color: rgba(126, 153, 161, 235);
    border-bottom-color: rgba(86, 105, 112, 235);
    border-left-color: rgba(112, 137, 145, 235);
    border-right-color: rgba(112, 137, 145, 235);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.unity-base-dropdown__container-inner {
    background-color: rgba(7, 22, 38, 255);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.unity-base-dropdown__item {
    min-height: 38px;
    padding-left: 8px;
    padding-right: 10px;
    padding-top: 7px;
    padding-bottom: 7px;
    margin-bottom: 2px;
    color: rgba(207, 218, 224, 255);
    background-color: rgba(17, 30, 43, 255);
    border-left-width: 3px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(120, 145, 153, 90);
    border-right-color: rgba(104, 124, 132, 45);
    border-top-color: rgba(126, 148, 156, 38);
    border-bottom-color: rgba(75, 91, 99, 70);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.unity-base-dropdown__item:hover {
    color: rgba(255, 255, 255, 255);
    background-color: rgba(18, 105, 140, 255);
    border-left-color: rgba(108, 230, 255, 255);
    border-right-color: rgba(108, 230, 255, 180);
    border-top-color: rgba(108, 230, 255, 180);
    border-bottom-color: rgba(108, 230, 255, 180);
    -unity-font-style: bold;
}

.unity-base-dropdown__item:checked {
    color: rgba(159, 247, 255, 255);
    background-color: rgba(13, 62, 86, 255);
    border-left-color: rgba(115, 245, 166, 255);
    border-right-color: rgba(115, 245, 166, 120);
    border-top-color: rgba(115, 245, 166, 120);
    border-bottom-color: rgba(115, 245, 166, 120);
}

.unity-base-dropdown__item:checked:hover {
    color: rgba(255, 255, 255, 255);
    background-color: rgba(18, 105, 140, 255);
    border-left-color: rgba(115, 245, 166, 255);
}

.unity-base-dropdown__item-content {
    flex-direction: row;
    align-items: center;
}

.unity-base-dropdown__checkmark {
    width: 10px;
    min-width: 10px;
    margin-right: 7px;
}

.unity-base-dropdown__item:checked > .unity-base-dropdown__item-content > .unity-base-dropdown__checkmark {
    background-color: rgba(115, 245, 166, 255);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.unity-base-dropdown__label {
    color: rgba(207, 218, 224, 255);
    -unity-text-align: middle-left;
}

.unity-base-dropdown__item:hover .unity-base-dropdown__label,
.unity-base-dropdown__item:checked:hover .unity-base-dropdown__label {
    color: rgba(255, 255, 255, 255);
}

.unity-base-dropdown__item:checked .unity-base-dropdown__label {
    color: rgba(159, 247, 255, 255);
}

.unity-base-dropdown__separator {
    height: 1px;
    margin-top: 4px;
    margin-bottom: 4px;
    background-color: rgba(125, 150, 158, 105);
}

.lobby-list,
.online-member-list {
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(51, 168, 204, 220);
    border-bottom-color: rgba(51, 168, 204, 220);
    border-left-color: rgba(51, 168, 204, 220);
    border-right-color: rgba(51, 168, 204, 220);
    background-color: rgba(7, 14, 24, 230);
}

.lobby-list:focus {
    border-top-color: rgba(108, 230, 255, 255);
    border-bottom-color: rgba(108, 230, 255, 255);
    border-left-color: rgba(108, 230, 255, 255);
    border-right-color: rgba(108, 230, 255, 255);
}

.lobby-row-label,
.online-member-name {
    color: rgba(218, 238, 255, 255);
}

.lobby-focus-group {
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-color: rgba(125, 150, 158, 35);
    border-bottom-color: rgba(125, 150, 158, 35);
    border-left-color: rgba(125, 150, 158, 35);
    border-right-color: rgba(125, 150, 158, 35);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.lobby-focus-group--active {
    background-color: rgba(10, 38, 58, 90);
    border-top-color: rgba(108, 230, 255, 230);
    border-bottom-color: rgba(108, 230, 255, 230);
    border-left-color: rgba(108, 230, 255, 230);
    border-right-color: rgba(108, 230, 255, 230);
}

.koiusa-theme .focus-group-title {
    margin-bottom: 8px;
    color: rgba(168, 181, 187, 255);
    font-size: 14px;
    -unity-font-style: bold;
}

.koiusa-theme .lobby-focus-group--active > .focus-group-title {
    color: rgba(185, 218, 215, 255);
}

.lobby-search-focus-group {
    margin-bottom: 10px;
}

.lobby-create-focus-group {
    margin-bottom: 10px;
}

.lobby-list-focus-group {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    height: 100%;
}
