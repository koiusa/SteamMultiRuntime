/* Stage Select Theme Styles */

.stage-select-panel {
	padding: 20px;
	margin: 10px;
	min-height: 200px;
	flex-direction: column;
}

.title {
	font-size: 24px;
	margin-bottom: 20px;
	padding-bottom: 10px;
	border-bottom-width: 2px;
	border-bottom-color: rgba(51, 168, 204, 180);
}

.stage-controls {
	flex-direction: column;
	padding: 15px;
	min-height: 80px;
}

.stage-controls > * {
	margin-bottom: 15px;
}

.stage-dropdown {
	--unity-cursor-color: rgba(150, 245, 255, 255);
	--unity-selection-color: rgba(65, 165, 210, 140);
}

.stage-dropdown > .unity-base-field__label {
	font-size: 14px;
	-unity-font-style: bold;
	margin-bottom: 8px;
}

.stage-dropdown > .unity-base-popup-field__input {
	padding: 8px;
}

.stage-dropdown > .unity-base-popup-field__arrow {
	color: rgba(117, 236, 255, 220);
}
