.character-select-root {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 24px;
    padding-bottom: 24px;
    background-color: rgba(0, 0, 0, 0.28);
}

.character-select-panel {
    min-width: 280px;
    width: 50%;
    max-width: 520px;
    max-height: 460px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 20px;
    padding-bottom: 20px;
}

.character-select-title {
    font-size: 32px;
    margin-bottom: 24px;
    -unity-text-align: middle-center;
}

.character-select-list {
    flex-grow: 1;
    min-height: 120px;
    max-height: 320px;
    margin-bottom: 16px;
}

.character-select-list > .unity-scroll-view__content-container {
    align-items: stretch;
}

.character-select-selected-name {
    color: rgb(245, 247, 250);
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.character-select-option {
    height: 40px;
    margin-bottom: 4px;
    align-self: stretch;
}
